{
  "name": "@max/dsh-mcp-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Progressive Disclosure tool search, manifest indexing, and lazy schema loading for DeepSeek Harness (DSH).",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./logo": "./logo.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-panel": "lib/cli.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --input-type=module -e 'import(\"./lib/index.js\"); console.log(\"✔ @max/dsh-mcp-adapter syntax and import valid\")'"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
